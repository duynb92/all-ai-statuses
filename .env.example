# PostgreSQL connection string (from Railway PostgreSQL add-on)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Secret for cron job authentication (generate with: openssl rand -hex 32)
CRON_SECRET=change-me

# Telegram Bot API token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Telegram group chat ID (negative number for groups)
TELEGRAM_CHAT_ID=-1001234567890

# Public Telegram group invite link
NEXT_PUBLIC_TELEGRAM_GROUP_LINK=https://t.me/+inviteCode

# Absolute base URL of this app (used by cron to call internal proxy routes)
NEXT_PUBLIC_APP_URL=https://your-app.railway.app
